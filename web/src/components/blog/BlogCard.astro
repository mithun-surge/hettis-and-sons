---
import { mediaUrl } from '../../lib/strapi';
import type { BlogPost } from '../../lib/types';

interface Props extends BlogPost {}
const { title, slug, excerpt, coverImage, category, publishDate } = Astro.props as Props;

const formattedDate = publishDate
  ? new Date(publishDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
  : '';
---

<article class="blog-card reveal tilt-card">
  {coverImage?.url && (
    <div class="ph">
      <img loading="lazy" decoding="async" src={mediaUrl(coverImage)} alt={coverImage.alternativeText || title} />
    </div>
  )}
  <div class="body">
    <span class="meta">{category}{category && formattedDate ? ' · ' : ''}{formattedDate}</span>
    <h3>{title}</h3>
    {excerpt && <p>{excerpt}</p>}
    <a href={`/blog/${slug}`} class="go">Read more →</a>
  </div>
</article>
