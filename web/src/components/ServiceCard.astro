---
interface Props {
  tag?: string;
  title: string;
  summary?: string;
  href: string;
  ctaLabel?: string;
}
const { tag, title, summary, href, ctaLabel = 'Learn more' } = Astro.props as Props;
---

<article class="scard reveal tilt-card">
  {tag && <span class="tag">{tag}</span>}
  <h3>{title}</h3>
  {summary && <p>{summary}</p>}
  <a href={href} class="more">{ctaLabel} <span class="arr">→</span></a>
</article>
