---
interface Props {
  variant?: 'hero' | 'phero' | 'cta' | 'footer';
}
const { variant = 'phero' } = Astro.props as Props;

const paths: Record<string, { viewBox: string; d: string[] }> = {
  hero: {
    viewBox: '0 0 1200 600',
    d: [
      'M-50 480 C 250 380 450 520 700 430 S 1100 360 1260 440',
      'M-50 430 C 250 330 450 470 700 380 S 1100 310 1260 390',
      'M-50 380 C 250 280 450 420 700 330 S 1100 260 1260 340',
      'M-50 330 C 250 230 450 370 700 280 S 1100 210 1260 290',
      'M-50 280 C 250 180 450 320 700 230 S 1100 160 1260 240',
      'M-50 230 C 250 130 450 270 700 180 S 1100 110 1260 190',
    ],
  },
  phero: {
    viewBox: '0 0 1200 500',
    d: [
      'M-50 400 C 300 320 500 440 750 360 S 1150 300 1260 380',
      'M-50 350 C 300 270 500 390 750 310 S 1150 250 1260 330',
      'M-50 300 C 300 220 500 340 750 260 S 1150 200 1260 280',
      'M-50 250 C 300 170 500 290 750 210 S 1150 150 1260 230',
    ],
  },
  cta: {
    viewBox: '0 0 1200 400',
    d: [
      'M-50 320 C 250 240 450 360 700 290 S 1100 230 1260 300',
      'M-50 280 C 250 200 450 320 700 250 S 1100 190 1260 260',
      'M-50 240 C 250 160 450 280 700 210 S 1100 150 1260 220',
      'M-50 200 C 250 120 450 240 700 170 S 1100 110 1260 180',
    ],
  },
  footer: {
    viewBox: '0 0 1200 400',
    d: [
      'M-50 320 C 250 240 450 360 700 290 S 1100 230 1260 300',
      'M-50 280 C 250 200 450 320 700 250 S 1100 190 1260 260',
      'M-50 240 C 250 160 450 280 700 210 S 1100 150 1260 220',
      'M-50 200 C 250 120 450 240 700 170 S 1100 110 1260 180',
    ],
  },
};

const p = paths[variant];
---

<div class="contour-overlay" aria-hidden="true">
  <svg viewBox={p.viewBox} preserveAspectRatio="none">
    <g fill="none" stroke="currentColor" stroke-width="1.4">
      {p.d.map((d) => <path d={d}></path>)}
    </g>
  </svg>
</div>
