---
import type { ChipBlock } from '../lib/types';

interface Props {
  label?: string;
  chips: ChipBlock[];
}
const { label, chips } = Astro.props as Props;
---

{chips?.length > 0 && (
  <div class="trust">
    <div class="wrap">
      {label && <span class="label">{label}</span>}
      <div class="chips">
        {chips.map((c) => <span>{c.text}</span>)}
      </div>
    </div>
  </div>
)}
